# Copier ce fichier en .env et le remplir. Le .env contient tes secrets : ne jamais le publier.

# --- Claude (obligatoire, l'un des deux) ---
# Abonnement Claude (Pro/Max) : générer le jeton avec
#   docker compose run --rm --entrypoint claude app setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# ...ou une clé API (facturée à l'usage, https://console.anthropic.com) :
ANTHROPIC_API_KEY=
# sonnet (conseillé) ou opus (meilleur, consomme plus de quota)
CLAUDE_MODEL=sonnet

# --- Ton propre Wiki.js (facultatif) : le dépôt Git que son stockage Git synchronise ---
# HTTPS avec un jeton qui a le droit d'écrire sur le dépôt :  https://<utilisateur>:<jeton>@github.com/<utilisateur>/<depot>.git
# ou SSH (clé dans ./ssh, voir docker-compose.yml) :            git@github.com:<utilisateur>/<depot>.git
WIKI_GIT_REMOTE=
WIKI_GIT_BRANCH=main
# adresse de ton wiki dans le navigateur (liens « Ouvrir le wiki » et pages enregistrées) : voir WIKI_SITE_URL plus bas

# --- Wiki.js fourni avec slide2wiki (facultatif, si tu n'en as pas) : enlever le # de la ligne suivante ---
#COMPOSE_PROFILES=wikijs
WIKI_ADMIN_EMAIL=admin@example.com
# 8 caractères minimum
WIKI_ADMIN_PASSWORD=
WIKI_SITE_URL=http://localhost:3000
DB_PASS=change-moi

# --- Accès réseau ---
# 127.0.0.1 = seulement depuis ce PC ; 0.0.0.0 = depuis tout le réseau local
# (la page de dépôt n'a pas de mot de passe : quelqu'un d'autre pourrait consommer ton quota Claude)
UPLOAD_BIND=127.0.0.1
WIKI_BIND=127.0.0.1
# ports sur ce PC (à changer si déjà pris par un autre programme) ; garder WIKI_SITE_URL cohérent
UPLOAD_PORT=8000
WIKI_PORT=3000

# --- Linux : uid/gid du propriétaire du dossier data/ (commande `id`) ---
PUID=1000
PGID=1000
